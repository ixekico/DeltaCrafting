{
  // 锚点标定表:坐标为客户区归一化比例(0..1),适配任意 16:9 分辨率。
  // 本表依据 2560×1440 实机截图标定(2026-07-26)。微调方法:总览页「单步调试→画面诊断」
  // 取整帧截图,像素值 ÷ 画面宽/高 即为比例;改保存后自动热重载,无需重启。
  // 界面流:mode-select →点烽火地带→(活动期可能插入 promo-announce,ESC 跳过)→
  // safehouse →Tab→ lobby →点顶栏特勤处→ specops-home;
  // 点设施槽位 → production(空闲)或 collect-result(完成)。
  "calibrated": true,
  "revision": 9,
  "calibratedOn": "2560×1440 实机标定；1920×1080 样本验证 2026-07-30(rev9:新增仓库空间不足 Toast 判定)",

  "keywords": {
    "idle": ["空闲中", "空闲"],
    "buttonProduce": ["生产"],
    "buttonReplenish": ["一键补齐", "补齐"],
    "buttonAbort": ["中止"],
    "buttonCollect": ["领取"],
    // 启动器上的进入游戏按钮文字(整窗 OCR 按文字定位点击,与分辨率无关)
    "launcherStart": ["开始游戏"]
  },

  "screens": {
    // 模式选择:两种左侧大卡样式都稳定显示下方分类标题「战役模式」。
    // 1080p 下卡片大字「烽火地带」会被系统 OCR 合并误读为「亠地带」,不作为判定词。
    "mode-select": {
      "probe": { "roi": { "x": 0.04, "y": 0.655, "w": 0.23, "h": 0.055 }, "mustContain": "战役模式" },
      "points": { "mode-entry": { "x": 0.27, "y": 0.382 } },
      "rois": {}
    },
    // 活动公告全屏(活动期内点烽火地带后弹出,可多页):判定词取底部中央「继续」提示——
    // 它是公告框架固有元素,与具体活动内容(标题/卡片)无关;跳过动作为按 ESC(代码内置,
    // 实测有效)。「继续」二字较通用,LaunchFlow 把本界面放在已知界面表末位判定,
    // 目标界面(大厅/基地等)优先成立。依据 2026-07 暑期活动公告的 2560×1440 实机截图标定。
    "promo-announce": {
      "probe": { "roi": { "x": 0.42, "y": 0.925, "w": 0.16, "h": 0.062 }, "mustContain": "继续" },
      "points": {},
      "rois": {}
    },
    // 3D 特勤基地:底部中央「Tab 开始游戏」提示;该提示纵向位置会随 HUD 浮动,
    // 探测区放宽到底部中央一整块(实测覆盖 y≈0.92~0.97 的两种位置);动作为按 Tab(代码内置)。
    "safehouse": {
      "probe": { "roi": { "x": 0.38, "y": 0.89, "w": 0.24, "h": 0.10 }, "mustContain": "开始游戏" },
      "points": {},
      "rois": {}
    },
    // 干员大厅:右下「行前备战」为大厅独有(区分于特勤处页);1.5x 可避免 1080p
    // 末字「战」在默认 2x 最近邻下误读为「找」。specops-entry=顶栏「特勤处」。
    "lobby": {
      "probe": { "roi": { "x": 0.79, "y": 0.865, "w": 0.18, "h": 0.062 }, "mustContain": "行前备战", "upscale": 1.5 },
      "points": { "specops-entry": { "x": 0.4375, "y": 0.0507 } },
      "rois": {}
    },
    // 特勤处总览(升级制造页):四个生产槽位一屏可见。
    // 槽位区域含 物品名+倒计时/「空闲中」,不含下方的设施说明文字。
    // back-to-lobby=顶栏「开始游戏」页签(收取后留在大厅挂机模式用它返回大厅)。
    "specops-home": {
      "probe": { "roi": { "x": 0.06, "y": 0.075, "w": 0.14, "h": 0.07 }, "mustContain": "升级制造" },
      "points": {
        "slot-tech-center": { "x": 0.1435, "y": 0.3956 },
        "slot-workbench": { "x": 0.33, "y": 0.3956 },
        "slot-pharmacy-lab": { "x": 0.1435, "y": 0.7164 },
        "slot-armor-station": { "x": 0.33, "y": 0.7164 },
        "back-to-lobby": { "x": 0.09, "y": 0.0507 }
      },
      "rois": {
        "slot-tech-center": { "x": 0.055, "y": 0.309, "w": 0.178, "h": 0.175 },
        "slot-workbench": { "x": 0.241, "y": 0.309, "w": 0.178, "h": 0.175 },
        "slot-pharmacy-lab": { "x": 0.055, "y": 0.629, "w": 0.178, "h": 0.175 },
        "slot-armor-station": { "x": 0.241, "y": 0.629, "w": 0.178, "h": 0.175 }
      }
    },
    // 生产界面(四设施同布局):左列配方列表,右下三态按钮(一键补齐/生产/中止)。
    // 判定词用顶部筛选栏「全部类型」:设施空闲/生产中都恒在(「已解锁」标题在生产中会消失)。
    // remaining-time 区域同时覆盖开工前「制造时长」与开工后「剩余时间」的数字位置。
    "production": {
      "probe": { "roi": { "x": 0.04, "y": 0.08, "w": 0.27, "h": 0.075 }, "mustContain": "全部类型" },
      "points": { "action-button": { "x": 0.90, "y": 0.881 } },
      "rois": {
        "list-area": { "x": 0.046, "y": 0.178, "w": 0.254, "h": 0.742 },
        "detail-title": { "x": 0.325, "y": 0.148, "w": 0.165, "h": 0.056 },
        "action-button": { "x": 0.82, "y": 0.85, "w": 0.15, "h": 0.062 },
        "remaining-time": { "x": 0.795, "y": 0.788, "w": 0.175, "h": 0.062 }
      }
    },
    // 一键补齐清单弹窗:buy=底部绿色总价按钮。
    // 实测「键」字常被 OCR 吞掉(读成「一补齐清单」),判定词取「补齐清单」抗丢字。
    "replenish-popup": {
      "probe": { "roi": { "x": 0.19, "y": 0.20, "w": 0.17, "h": 0.10 }, "mustContain": "补齐清单" },
      "points": { "buy": { "x": 0.50, "y": 0.699 } },
      "rois": {}
    },
    // 领取结算(获得奖励)全屏:dismiss=底部中央「继续」。判定词取「奖励」抗丢字。
    "collect-result": {
      "probe": { "roi": { "x": 0.40, "y": 0.185, "w": 0.20, "h": 0.09 }, "mustContain": "奖励" },
      "points": { "dismiss": { "x": 0.501, "y": 0.957 } },
      "rois": {}
    },
    // 中止确认弹窗:居中提示「是否中止…材料将不退回。」,底部左「取消」右「中止」(绿色)。
    // 判定词用「不退回」(该弹窗独有,抗丢字);confirm=右侧「中止」按钮中心。
    "abort-confirm": {
      "probe": { "roi": { "x": 0.36, "y": 0.40, "w": 0.28, "h": 0.075 }, "mustContain": "不退回" },
      "points": { "confirm": { "x": 0.582, "y": 0.622 } },
      "rois": {}
    },
    // 补齐材料或领取产物时仓库已满:顶部中央短暂出现同一 Toast。
    // 它是叠加状态而非独立页面；流程会与正常成功状态并行探测，一旦命中立即中止本轮。
    "warehouse-full": {
      "probe": { "roi": { "x": 0.42, "y": 0.135, "w": 0.18, "h": 0.065 }, "mustContain": "仓库空间不足" },
      "points": {},
      "rois": {}
    }
