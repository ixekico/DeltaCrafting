<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3 前端(unpackaged,双击即用)。UI 只消费 Core 的 L3/L0,不越层调用。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>DeltaCrafter.App</RootNamespace>
    <AssemblyName>DeltaCrafter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 不打 MSIX:unpackaged + WinAppSDK 自包含,免安装依赖直接运行。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- 自定义 Program.Main 做单实例重定向,禁用 XAML 生成的入口。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- 固定在 1.7.x LTS 线:确切支持 .NET 8(net8.0-windows10.0.19041)。
         2.x 的 .NET 8 支持尚不明确,不为追新版而冒构建失败的风险。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- 2.4.x 起仅支持 net10;2.3.0 是支持 net8.0-windows 的最新稳定版(依赖 WinAppSDK>=1.6,兼容)。 -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeltaCrafter.Core\DeltaCrafter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationManifest 属性已负责嵌入 app.manifest,无需再声明 Manifest 项。 -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
