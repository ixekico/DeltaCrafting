<Page
    x:Class="DeltaCrafter.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeltaCrafter.App.Controls"
    xmlns:vm="using:DeltaCrafter.App.ViewModels">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <!-- 星号三列确定性居中(同 PlanPage 注释):不依赖 Stretch+MaxWidth 的对齐退化。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="999*" MaxWidth="{StaticResource TokenContentMaxWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Padding="{StaticResource TokenPagePadding}"
                        Spacing="{StaticResource TokenGapL}">

                <controls:PageHeader Title="总览" Subtitle="监控四个特勤处设施,并手动或按计划执行收取与续造。" />

                <!-- 运行状态卡:主操作(执行/停止)+ 单步调试 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="{x:Bind Vm.RunStateTitle, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Vm.RunStateDetail, Mode=OneWay}"
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="开始制造"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind Vm.RunNowCommand}"
                                    IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                            <Button Content="识别当前任务"
                                    Command="{x:Bind Vm.SyncNowCommand}"
                                    IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay, Converter={StaticResource InvertBool}}"
                                    ToolTipService.ToolTip="上号识别四个设施当前的状态、物品与剩余时间并同步到调度,不领取、不开工。适合首次使用时特勤处已经在制造的情况。" />
                            <Button Content="停止"
                                    Command="{x:Bind Vm.StopCommand}"
                                    IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay}" />
                            <Button Content="单步调试"
                                    Visibility="{x:Bind Vm.DebugVisibility, Mode=OneWay}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="仅启动到大厅" Command="{x:Bind Vm.DebugLobbyCommand}" />
                                        <MenuFlyoutItem Text="进入特勤处" Command="{x:Bind Vm.DebugSpecOpsCommand}" />
                                        <MenuFlyoutItem Text="截图并识别当前画面" Command="{x:Bind Vm.DebugDumpCommand}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="扫描配方目录(补全物品候选)" Command="{x:Bind Vm.DebugScanCatalogCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="下次执行" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{x:Bind Vm.NextRunText, Mode=OneWay}"
                                           Style="{StaticResource NumericTextStyle}" />
                            </StackPanel>
                            <InfoBar Grid.Column="1"
                                     IsOpen="{x:Bind Vm.LastRunFailed, Mode=OneWay}"
                                     Severity="Error"
                                     IsClosable="False"
                                     Title="上一轮执行失败"
                                     Message="{x:Bind Vm.LastRunSummary, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 四设施卡 -->
                <ItemsRepeater ItemsSource="{x:Bind Vm.Facilities}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="252" MinItemHeight="168"
                                           MinColumnSpacing="16" MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FacilityCardModel">
                            <controls:FacilityCard Model="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 最近日志摘要 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="最近动态" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind Vm.RecentLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource SecondaryTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
