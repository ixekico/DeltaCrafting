<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 圆角卡片:内容页唯一的分组容器,颜色取系统 Card 资源,深浅色自动切换。 -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource TokenCornerCard}" />
        <Setter Property="Padding" Value="{StaticResource TokenCardPadding}" />
    </Style>

    <!-- 卡片内小标题 -->
    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- 次要说明文字 -->
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 数字/倒计时:等宽数字,避免每秒跳动时抖宽 -->
    <Style x:Key="NumericTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI" />
    </Style>

</ResourceDictionary>
