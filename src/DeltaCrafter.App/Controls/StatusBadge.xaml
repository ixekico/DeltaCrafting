<UserControl
    x:Class="DeltaCrafter.App.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 圆角胶囊。背景色按 Level 走 VisualState 切换,颜色全部取系统语义 ThemeResource,
         深浅色主题实时生效;无任何尖角。 -->
    <Border x:Name="Root"
            CornerRadius="{StaticResource TokenCornerBadge}"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            Padding="10,3,10,4"
            VerticalAlignment="Center">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LevelStates">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Info">
                    <VisualState.Setters>
                        <Setter Target="Root.Background"
                                Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="Root.Background"
                                Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="Root.Background"
                                Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="Root.Background"
                                Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}" />
    </Border>
</UserControl>
